{
  "name": "lidcohs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "LIDCOHS REST API — Node.js + Express + TypeScript, backed by Supabase PostgreSQL",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
